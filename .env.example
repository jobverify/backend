# MongoDB keys
PORT=5290
MONGO_URI=
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
NODE_ENV=development
# Production rate limits are mandatory and use shared MongoDB counters.
# Set true to exercise quotas locally; production ignores false.
ENABLE_RATE_LIMITING=
NODE_OPTIONS=--openssl-legacy-provider

# Server-only secret shared with the frontend hosting environment (at least 32 characters).
JOBVERIFY_PUBLISHING_TOKEN=

# Google signin
GOOGLE_CLIENT_ID=

# Github Action workflow Pipeline keys
# GitHub execution requires Contents read + Actions write. Schedule edits use MongoDB.
# Defaults on in production and off elsewhere. Set false to disable during rollout.
SCRAPER_SCHEDULER_ENABLED=
GITHUB_PAT=
GITHUB_REPO=jobverify/jobverify-backend
SCRAPER_CONCURRENCY=10
WORKDAY_DETAIL_FETCH_CONCURRENCY=1
TRUST_PROXY=1

# Public job browsing abuse guard
PUBLIC_JOB_ABUSE_PAGE_WALK_WINDOW_MS=60000
PUBLIC_JOB_ABUSE_PAGE_WALK_LIMIT=30
PUBLIC_JOB_ABUSE_DETAIL_WINDOW_MS=60000
PUBLIC_JOB_ABUSE_DETAIL_LIMIT=90
PUBLIC_JOB_ABUSE_VIOLATION_WINDOW_MS=900000
PUBLIC_JOB_ABUSE_VIOLATION_LIMIT=5
PUBLIC_JOB_ABUSE_BLOCK_MS=900000
PUBLIC_JOB_ABUSE_MAX_RECORDS=5000

# Email verification using SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional registration verification and password-reset delivery through the private Gmail Worker.
# Leave both blank for direct SMTP. URL is the Worker origin (no path).
EMAIL_RELAY_URL=
EMAIL_RELAY_SECRET=

# Cloudflare Trunstile captcha keys
TURNSTILE_SECRET_KEY=
# Production startup fails if the secret, allowed hostnames, or expected action is missing.
# Use www.jobverify.in (not localhost) for TURNSTILE_ALLOWED_HOSTNAMES in production.
#0x4AAAAAAERupRubdcfU0AmzszzdzfUsieI
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
TURNSTILE_EXPECTED_ACTION=login

# Razorpay payment gateway
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Telegram Alert Bot
TELEGRAM_BOT_USERNAME=jobverify_alert_bot
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=



# Local CPU description rewriting (GitHub Actions defaults to publish)
JOB_DESCRIPTION_REWRITE_MODE=off
JOB_DESCRIPTION_REWRITE_BUDGET_SECONDS=1200
JOB_DESCRIPTION_REWRITE_CPU_THREADS=2
JOB_DESCRIPTION_REWRITE_CONCURRENCY=1
# Optional compatible GPU runtime; default remains the pinned CPU build.
JOB_DESCRIPTION_REWRITE_GPU_LAYERS=0
JOB_DESCRIPTION_REWRITE_BINARY=
JOB_DESCRIPTION_REWRITE_BINARY_SHA256=

# Enable only on the backend running on your own PC. Uses this backend's MONGO_URI.
PIPELINE_LOCAL_ENABLED=false

# Tailored resumes run a local model in tailored-resumes.yml, with no inference API.
# Uses GITHUB_PAT and the resume repository's MONGO_URI Actions secret.
# Falls back to GITHUB_REPO only when TAILORED_RESUME_GITHUB_REPO is unset.
TAILORED_RESUME_GITHUB_REPO=jobverify/backend
# Available when GitHub credentials are configured; set false to disable dispatch.
TAILORED_RESUME_ACTIONS_ENABLED=true


# Scoped SEO tooling (server-only; never prefix these with VITE_).
SEO_TOOLS_TOKEN=
SERPAPI_KEY=
ANTHROPIC_API_KEY=
# Choose a Messages API model available to your Anthropic account.
ANTHROPIC_MODEL=

# Job-link verification for all signed-in accounts (free public sources).
JOB_VERIFICATION_ENABLED=false
