</style></div></div></div></div></div></section><section class="section_logo"><div class="looping-logos-code w-embed"><style>
/* Brand Logos animation on the Hero section (home-page)*/
  @keyframes scroll-brand-logos {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-100% - 4rem));
    }
  }

  .scroll-brand-logos {
    animation: scroll-brand-logos 40s linear infinite;
  }

  .reverse-brand-logos {
    animation-direction: reverse;
  }

  /* Adjust speed and gap for 568px and below */
  @media (max-width: 568px) {
    @keyframes scroll-brand-logos {
      from {
        transform: translateX(0);
      }
      to {
        transform: translateX(calc(-100% - 2rem)); /* Adjusted gap */
      }
    }

    .scroll-brand-logos {
      animation: scroll-brand-logos 35s linear infinite; /* Slower speed */
    }
      .reverse-brand-logos {
    animation-direction: reverse;
  }
</style>

