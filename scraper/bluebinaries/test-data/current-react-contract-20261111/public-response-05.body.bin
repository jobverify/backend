<!-- Accordion: unified function for FAQ + footer dropdowns -->
<script defer>
  document.addEventListener('DOMContentLoaded', function () {
    function initAccordion(selector) {
      document.querySelectorAll(selector).forEach(function (toggle) {
        toggle.addEventListener('click', function () {
          var content = this.nextElementSibling;
          var dur = 200;
          document.querySelectorAll(selector + '.open').forEach(function (open) {
            if (open === toggle) return;
            var c = open.nextElementSibling;
            requestAnimationFrame(function () {
              c.style.height = c.scrollHeight + 'px';
              requestAnimationFrame(function () {
                c.style.transition = 'height ' + dur + 'ms ease-out';
                c.style.height = '0px';
              });
            });
            open.classList.remove('open');
          });
          if (this.classList.contains('open')) {
            requestAnimationFrame(function () {
              content.style.height = content.scrollHeight + 'px';
              requestAnimationFrame(function () {
                content.style.transition = 'height ' + dur + 'ms ease-out';
                content.style.height = '0px';
              });
            });
          } else {
            content.style.height = '0px';
            requestAnimationFrame(function () {
              content.style.transition = 'height ' + dur + 'ms ease-out';
              content.style.height = content.scrollHeight + 'px';
            });
          }
          this.classList.toggle('open');
        });
      });
    }
    initAccordion('.faq_toggle');
    initAccordion('.faq_dropdown-toggle');
  });
</script>

<!-- Nav tabs: hover to activate -->
<script defer>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.nav-tabs').forEach(function (tabs) {
      var btns = tabs.querySelectorAll('.dropdown-tab-link');
      var panels = tabs.querySelectorAll('.tab-panel');
      btns.forEach(function (btn) {
        btn.addEventListener(
          'mouseenter',
          function (e) {
            e.preventDefault();
            e.stopPropagation();
            var idx = parseInt(btn.dataset.tab, 10);
            btns.forEach(function (b) {
              b.classList.remove('is-active');
            });
            panels.forEach(function (p) {
              p.classList.remove('is-active');
            });
            btn.classList.add('is-active');
            if (panels[idx]) panels[idx].classList.add('is-active');
          },
          { passive: false },
        );
      });
    });
  });
</script>

<!-- Merged styles: accordion, tabs, HubSpot widget, news scroll -->
<style>
  .faq_content,
  .faq_dropdown-content {
    overflow: hidden;
  }
  .tab-panel {
    display: none;
  }
  .tab-panel.is-active {
    display: block;
  }
  .dropdown-tab-link {
    opacity: 0.6;
  }
  .dropdown-tab-link.is-active {
    opacity: 1;
  }
  .dnd_area-module-7-padding > #hs_cos_wrapper_dnd_area-module-7,
  .widget_1762435965383-padding > #hs_cos_wrapper_widget_1762435965383 {
    width: 100% !important;
    max-width: 100% !important;
    display: block;
  }
  /* News scroll: only on desktop, only if motion is OK */
  @media (min-width: 992px) {
    @media (prefers-reduced-motion: no-preference) {
      .news_card-container.scroll-featured-news {
        animation: scroll-featured-news 60s linear infinite;
        will-change: transform;
        transform: translate3d(0, 0, 0);
      }
      @keyframes scroll-featured-news {
        from {
          transform: translate3d(0, 0, 0);
        }
        to {
          transform: translate3d(calc(-100% - 1.5rem), 0, 0);
        }
      }
    }
  }
</style><!-- Hero Lottie: hide via CSS instantly, no load event needed -->
<style>
  @media (max-width: 768px) {
    .hero_lottie {
      display: none !important;
    }
  }
</style>

<!-- Splide Slider -->
<script defer src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js"></script>
<script defer>
  window.addEventListener('load', function () {
    var splides = document.querySelectorAll('.sliderfeatured');
    if (!splides.length) return;
    splides.forEach(function (slider) {
      if (!slider.querySelector('.splide__track')) return;
      new Splide(slider, {
        perPage: 1.1,
        perMove: 1,
        focus: 'center',
        type: 'slide',
        gap: '1.5em',
        start: 1,
        arrows: false,
        pagination: true,
        speed: 600,
        dragAngleThreshold: 60,
        autoWidth: false,
        rewind: false,
        rewindSpeed: 400,
        waitForTransition: false,
        updateOnMove: true,
        trimSpace: false,
        breakpoints: {
          991: { perPage: 2, gap: '3vw', focus: 0, start: 0 },
          767: { perPage: 1.05, gap: '3vw', focus: 0, start: 0 },
          479: { perPage: 1.05, gap: '3vw', focus: 0, start: 0 },
        },
      }).mount();
    });
  });
</script>

<!-- Prevent CLS for Logo Sections: no changes needed -->
<style>
  .section_logo_static {
    display: none;
  }
  .section_logo,
  .section_logo_static {
    min-height: 120px;
  }
</style>

<!-- Geo Based Logo: moved to after load to avoid blocking DOMContentLoaded -->
<script defer>
  window.addEventListener('load', function () {
    async function geoLogo() {
      let country = localStorage.getItem('user_country');
      if (!country) {
        try {
          const res = await fetch('https://ipapi.co/json/');
          const data = await res.json();
          country = data.country_code;
          localStorage.setItem('user_country', country);
        } catch (e) {
          return;
        }
      }
      const def = document.querySelector('.section_logo');
      const stat = document.querySelector('.section_logo_static');
      if (!def || !stat) return;
      if (country === 'US' || country === 'CA') {
        def.style.display = 'none';
        stat.style.display = 'block';
      }
    }
    geoLogo();
  });
</script>

<!-- Accessibility dialog labels: observer disconnects after first success -->
<script defer>
  window.addEventListener('load', function () {
    function labelDialogs() {
      var found = false;
      document.querySelectorAll('[role="dialog"]').forEach(function (dialog) {
        if (!dialog.hasAttribute('aria-label')) {
          dialog.setAttribute('aria-label', 'Book a Demo Call');
          found = true;
        }
      });
      return found;
    }
    if (labelDialogs()) return; // already found on load, no observer needed
    var observer = new MutationObserver(function () {
      if (labelDialogs()) observer.disconnect(); // stop watching once done
    });
    observer.observe(document.body, { childList: true, subtree: true });
  });
</script><script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML="window.__CF$cv$params={r:'a58dc617be309425',t:'MTc5NDQwNTEwOA=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a58dc617be309425',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body></html>