{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "dist/worker.js",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "no_bundle": true,
  "ai": { "binding": "AI" },
  "r2_buckets": [{ "binding": "SOCIAL_ASSETS", "bucket_name": "jobverify-social-assets" }],
  "workers_dev": true,
  "preview_urls": false,
  "dev": { "host": "localhost" },
  "secrets": {
    "required": [
      "MONGO_URI", "JWT_SECRET", "EMAIL_RELAY_URL", "EMAIL_RELAY_SECRET",
      "TURNSTILE_SECRET_KEY", "TURNSTILE_ALLOWED_HOSTNAMES", "TURNSTILE_EXPECTED_ACTION"
    ]
  },
  "routes": [{ "pattern": "api.jobverify.in", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "API", "class_name": "JobverifyApi" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JobverifyApi"] }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "NODE_ENV": "production",
    "TRUST_PROXY": "1",
    "CORS_ORIGIN": "https://www.jobverify.in,https://jobverify.in",
    "FRONTEND_ORIGIN": "https://www.jobverify.in",
    "PUBLIC_API_ORIGIN": "https://api.jobverify.in",
    "SOCIAL_GITHUB_REPOSITORY": "jobverify/backend",
    "SOCIAL_VIDEO_OIDC_AUDIENCE": "https://api.jobverify.in/api/social-video-drafts",
    "SOCIAL_OIDC_AUDIENCE": "https://api.jobverify.in/api/social-publisher/run",
    "SOCIAL_LINKEDIN_API_VERSION": "202611",
    "SOCIAL_INSTAGRAM_API_VERSION": "v27.0",
    "AUTH_COOKIE_SAME_SITE": "lax",
    "PIPELINE_LOCAL_ENABLED": "false",
    "JOB_VERIFICATION_ENABLED": "false",
    "AUTO_APPLY_ENABLED": "false",
    "SCRAPER_SCHEDULER_ENABLED": "true",
    "CLOUDFLARE_MAINTENANCE_ENABLED": "true",
    "TELEGRAM_ENABLED": "true",
    "TELEGRAM_BOT_USERNAME": "jobverify_alert_bot"
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "redact_query_string": true }
}

